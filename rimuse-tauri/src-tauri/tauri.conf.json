{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rimuse-shell",
  "version": "0.1.0",
  "identifier": "dev.rimuse.shell",
  "build": {
    "frontendDist": "./frontend-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rimuse Shell",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "additionalBrowserArgs": "--remote-debugging-port=9224"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["resources/bin/goose.exe"]
  }
}
