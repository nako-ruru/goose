# rimuse-tauri build outputs — never enter the tree.
# Kept in our own .gitignore (not the repo root) so the upstream goose
# .gitignore stays byte-identical.

# cargo build output (also covered by the root target/ rule; explicit here)
src-tauri/target/

# Vite build output — regenerated by `VITE_SHELL=tauri npm run build`
src-tauri/frontend-dist/

# The164 MB goose backend, staged only for local NSIS bundling
# (remote_build.py stages it into the zip at pack time instead)
src-tauri/resources/
